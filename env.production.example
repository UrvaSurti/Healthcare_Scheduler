# Production Environment Variables for Docker
# Copy this file to .env.local in production or set these as environment variables

# JWT Secret for authentication (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=healthcare-scheduler-jwt-secret-key-2024-production

# Node Environment
NODE_ENV=production

# Optional: Custom port (Docker exposes 3000 by default)
# PORT=3000

# Optional: Database connection (if you add a database later)
# DATABASE_URL=postgresql://user:password@localhost:5432/healthcare_scheduler

# Optional: External API keys (if needed)
# EXTERNAL_API_KEY=your-api-key-here 